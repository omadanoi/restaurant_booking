ENV=development
LOG_LEVEL=INFO

PROJECT_NAME="Restaurant Reservation & Table Management Platform"
API_V1_STR=/api/v1

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=restaurant_platform

# Full DSNs (override the pieces above directly if preferred)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/restaurant_platform
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/restaurant_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth (Phase 2+)
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS
CORS_ORIGINS=["http://localhost:5173"]
