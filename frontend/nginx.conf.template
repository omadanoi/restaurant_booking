# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's own envsubst step, so managed hosts can inject the port to bind.
# Only real environment variables are substituted — nginx's own $uri survives.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA routing: unknown paths fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
}
